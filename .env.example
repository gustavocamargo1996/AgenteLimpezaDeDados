# Copie (nao renomeie) para .env e preencha. O .env esta no .gitignore.
#   cp .env.example .env
# So' e' necessaria com PROVEDOR=openai.
OPENAI_API_KEY=sk-cole-sua-chave-aqui

# Opcionais (ja tem default em limpeza/config.py)
MODELO_LLM=gpt-4o-mini

# openai (default) ou ollama. Valor desconhecido FALHA -- nunca cai para openai
# em silencio, porque isso mandaria dado para fora da rede.
PROVEDOR=openai
OLLAMA_URL=http://localhost:11434

# Sobrepoe MODELO_LLM num papel so'. Vazio = usa o geral.
# MODELO_DETECCAO=qwen2.5-coder:14b
# MODELO_ESPECIFICADOR=
# MODELO_CODIGO=
# MODELO_FD=

# Timeout de uma chamada de LLM, em segundos. Sobrepoe os dois defaults
# (180 no openai, 900 no ollama, que em CPU ja levou 808s numa chamada).
# TIMEOUT_LLM=900

# Caminhos, para quando a POC roda em container (o Portainer edita isto).
# SUJO=/dados/entrada_dirty.csv
# LIMPO=/dados/entrada_clean.csv
# SAIDA=/dados/runs

# Pasta local do modelo MiniLM (tokenizer.json + onnx/model_O4.onnx).
MODELO_EMBEDDING=F:\caminho\para\all-MiniLM-L6-v2
